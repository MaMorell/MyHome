@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Globalization
@using System.Text.Json
@using MyHome.Core.Models.EnergySupplier
@using MyHome.Core.Models.EnergySupplier.Enums
@using MyHome.Web.Services
@inject EnergyDashboardClient Dashboard
@inject ILogger<Home> Logger

<PageTitle>Energy dashboard | MyHome</PageTitle>

<div class="shell">
    <aside class="sidebar">
        <a class="brand" href="/" aria-label="MyHome dashboard">
            <span class="brand-icon">M<span>.</span></span>
            <span>myhome<span class="brand-subtitle">ENERGY INTELLIGENCE</span></span>
        </a>

        <div class="nav-label">WORKSPACE</div>
        <nav aria-label="Dashboard navigation">
            <a class="nav-link active" href="#overview"><span class="nav-symbol">◫</span> Overview</a>
            <a class="nav-link" href="#prices"><span class="nav-symbol">▥</span> Price explorer</a>
            <a class="nav-link" href="#automation"><span class="nav-symbol">⚙</span> Device outlook</a>
            <a class="nav-link" href="#consumption"><span class="nav-symbol">◷</span> Consumption</a>
        </nav>

        <div class="sidebar-bottom">
            <div class="connection-indicator"><span class="status-dot @(_priceError is not null ? "status-error" : "")"></span> @(_priceError is not null ? "Price feed unavailable" : _loading ? "Connecting to MyHome API" : "Tibber prices via MyHome API")</div>
            <div class="sidebar-note">Smart energy, clearer decisions.</div>
        </div>
    </aside>

    <main class="main-content" id="overview">
        <header class="topbar">
            <div class="breadcrumb">HOME <span>/</span> ENERGY OVERVIEW</div>
            <div class="topbar-right">
                <span class="today-label">@DateTime.Now.ToString("dddd, d MMMM yyyy", CultureInfo.InvariantCulture)</span>
                <span class="avatar" aria-hidden="true">M</span>
            </div>
        </header>

        <div class="page-content">
            <div class="page-heading">
                <div>
                    <div class="eyebrow"><span class="eyebrow-line"></span> YOUR HOME AT A GLANCE</div>
                    <h1>Energy overview<span class="heading-dot">.</span></h1>
                    <p>Know what your energy costs, and when it pays to use it.</p>
                </div>
                <button class="refresh-button" type="button" @onclick="RefreshAsync" disabled="@_loading">
                    <span aria-hidden="true">↻</span> @(_loading ? "Loading..." : "Refresh data")
                </button>
            </div>

            @if (_priceError is not null)
            {
                <div class="alert" role="alert">
                    <strong>Some data could not be loaded.</strong>
                    <span>@_priceError</span>
                </div>
            }

            @if (_loading && _prices.Count == 0)
            {
                <div class="loading-state" role="status">Loading live energy data...</div>
            }

            <section class="panel price-panel" id="prices" aria-labelledby="prices-title">
                <div class="panel-header">
                    <div>
                        <div class="section-kicker">THE BIG PICTURE</div>
                        <h2 id="prices-title">Electricity prices</h2>
                        <p>Quarter-hour spot prices from Tibber, colored by MyHome's internal price level.</p>
                    </div>
                    <div class="segmented-control" aria-label="Select price day">
                        <button type="button" class="@(!_showTomorrow ? "selected" : "")" aria-pressed="@(!_showTomorrow)" @onclick="() => _showTomorrow = false">Today</button>
                        <button type="button" class="@(_showTomorrow ? "selected" : "")" aria-pressed="@_showTomorrow" @onclick="() => _showTomorrow = true">Tomorrow</button>
                    </div>
                </div>

                @if (VisiblePrices.Count > 0)
                {
                    <div class="chart-summary">
                        <span>@SelectedDay.ToString("dddd, d MMMM", CultureInfo.InvariantCulture)</span>
                        <span>Average <strong>@Price(VisiblePrices.Average(e => e.PriceDetails.PriceTotal)) SEK/kWh</strong></span>
                        <span>Low <strong>@Price(VisiblePrices.Min(e => e.PriceDetails.PriceTotal))</strong></span>
                        <span>High <strong>@Price(VisiblePrices.Max(e => e.PriceDetails.PriceTotal))</strong></span>
                    </div>
                    <div class="chart-frame">
                        <div class="chart-y-label">SEK / kWh</div>
                        <div class="chart-plot" role="img" aria-label="Quarter-hour electricity prices for @SelectedDay.ToString("d MMMM", CultureInfo.InvariantCulture), from @Price(VisiblePrices.Min(e => e.PriceDetails.PriceTotal)) to @Price(VisiblePrices.Max(e => e.PriceDetails.PriceTotal)) SEK per kWh; colors represent MyHome internal price levels">
                            <div class="chart-gridline top"><span>@Price(ChartMax)</span></div>
                            <div class="chart-gridline middle"><span>@Price((ChartMax + ChartMin) / 2)</span></div>
                            <div class="chart-gridline zero" style="bottom:@ChartZeroPosition()"><span>@Price(0)</span></div>
                            @foreach (var entry in VisiblePrices)
                            {
                                <div class="chart-slot">
                                    <div class="price-bar @LevelClass(entry.PriceDetails.LevelInternal) @(entry.PriceDetails.PriceTotal < 0 ? "negative" : "") @(entry.PriceDetails.StartsAt < DateTimeOffset.Now ? "past" : "")"
                                         style="@BarStyle(entry)"
                                         title="@PriceTooltip(entry)"></div>
                                </div>
                            }
                        </div>
                        <div class="chart-axis">
                            @for (var i = 0; i < VisiblePrices.Count; i++)
                            {
                                <div class="axis-slot">
                                    @if (VisiblePrices[i].PriceDetails.StartsAt.Minute == 0 && VisiblePrices[i].PriceDetails.StartsAt.Hour % 4 == 0)
                                    {
                                        <span>@VisiblePrices[i].PriceDetails.StartsAt.ToString("HH:mm")</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                    <div class="chart-legend">
                        <strong>MYHOME INTERNAL LEVEL</strong>
                        <span><i class="legend-dot very-cheap"></i> Very cheap</span>
                        <span><i class="legend-dot cheap"></i> Cheap</span>
                        <span><i class="legend-dot normal"></i> Normal</span>
                        <span><i class="legend-dot expensive"></i> Expensive</span>
                        <span><i class="legend-dot very-expensive"></i> Very expensive</span>
                        <span><i class="legend-dot unknown"></i> Unknown</span>
                    </div>
                }
                else
                {
                    <div class="empty-state">No prices are available for @(_showTomorrow ? "tomorrow yet. Tibber usually publishes tomorrow's prices in the afternoon." : "today.")</div>
                }
            </section>

            <footer class="footer">
                <span>MYHOME <span class="footer-divider">/</span> ENERGY DASHBOARD</span>
                <span>@(_lastUpdated is null ? "Waiting for data" : $"Updated {_lastUpdated:HH:mm:ss}") · Prices provided by Tibber</span>
            </footer>
        </div>
    </main>
</div>

@code {
    private static readonly CultureInfo NumberCulture = CultureInfo.GetCultureInfo("sv-SE");
    private IReadOnlyList<EnergyConsumptionEntry> _prices = [];
    private DateOnly _today = DateOnly.FromDateTime(DateTime.Now);
    private DateTime? _lastUpdated;
    private string? _priceError;
    private bool _loading = true;
    private bool _showTomorrow;

    private DateOnly SelectedDay => _today.AddDays(_showTomorrow ? 1 : 0);
    private IReadOnlyList<EnergyConsumptionEntry> VisiblePrices => _prices
        .Where(e => DateOnly.FromDateTime(e.PriceDetails.StartsAt.DateTime) == SelectedDay)
        .OrderBy(e => e.PriceDetails.StartsAt)
        .ToList();
    private decimal ChartMin => Math.Min(0, VisiblePrices.Min(e => e.PriceDetails.PriceTotal));
    private decimal ChartMax => Math.Max(0, VisiblePrices.Max(e => e.PriceDetails.PriceTotal));
    private decimal ChartRange => ChartMax == ChartMin ? 1 : ChartMax - ChartMin;

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    private async Task RefreshAsync()
    {
        _loading = true;
        _priceError = null;
        _today = DateOnly.FromDateTime(DateTime.Now);

        try
        {
            _prices = await Dashboard.GetPricesAsync();
            _lastUpdated = DateTime.Now;
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or TaskCanceledException or InvalidOperationException)
        {
            Logger.LogError(ex, "Could not load Tibber energy prices");
            _priceError = _prices.Count > 0 ? "Prices could not be refreshed; previously loaded prices are shown." : "Prices are unavailable.";
        }

        _loading = false;
    }

    private static string Price(decimal value) => value.ToString("0.00", NumberCulture);
    private static string Quantity(decimal value) => value.ToString("0.#", NumberCulture);

    private static string LevelName(EnergyPriceLevel level) => level switch
    {
        EnergyPriceLevel.VeryCheap => "Very cheap",
        EnergyPriceLevel.Cheap => "Cheap",
        EnergyPriceLevel.Normal => "Normal",
        EnergyPriceLevel.Expensive => "Expensive",
        EnergyPriceLevel.VeryExpensive => "Very expensive",
        _ => "Unknown"
    };

    private static string LevelClass(EnergyPriceLevel level) => level switch
    {
        EnergyPriceLevel.VeryCheap => "very-cheap",
        EnergyPriceLevel.Cheap => "cheap",
        EnergyPriceLevel.Normal => "normal",
        EnergyPriceLevel.Expensive => "expensive",
        EnergyPriceLevel.VeryExpensive => "very-expensive",
        _ => "unknown"
    };

    private string ChartZeroPosition() =>
        FormattableString.Invariant($"{(double)(-ChartMin / ChartRange) * 100:0.##}%");

    private string BarStyle(EnergyConsumptionEntry entry)
    {
        var price = entry.PriceDetails.PriceTotal;
        var bottom = (price < 0 ? price - ChartMin : -ChartMin) / ChartRange * 100;
        var height = Math.Abs(price) / ChartRange * 100;
        return FormattableString.Invariant($"bottom:{bottom:0.##}%;height:{height:0.##}%");
    }

    private string PriceTooltip(EnergyConsumptionEntry entry)
    {
        var details = entry.PriceDetails;
        return $"{details.StartsAt:HH:mm} — {Price(details.PriceTotal)} SEK/kWh · MyHome: {LevelName(details.LevelInternal)} · Tibber: {LevelName(details.LevelExternal)}";
    }
}
