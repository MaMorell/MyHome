@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.Globalization
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using MyHome.Core.Models.Entities.Profiles
@using MyHome.Core.Models.EnergySupplier
@using MyHome.Core.Models.EnergySupplier.Enums
@using MyHome.Core.Models.Integrations.HeatPump
@using MyHome.Web.Services
@inject EnergyDashboardClient Dashboard
@inject DeviceSettingsClient DeviceSettings
@inject ILogger<Home> Logger

<PageTitle>Energy dashboard | MyHome</PageTitle>

<div class="shell">
    <aside class="sidebar">
        <a class="brand" href="/" aria-label="MyHome dashboard">
            <span class="brand-icon">M<span>.</span></span>
            <span>myhome<span class="brand-subtitle">ENERGY INTELLIGENCE</span></span>
        </a>

        <div class="nav-label">WORKSPACE</div>
        <nav aria-label="Dashboard navigation">
            <a class="nav-link active" href="#overview"><span class="nav-symbol">◫</span> Overview</a>
            <a class="nav-link" href="#prices"><span class="nav-symbol">▥</span> Price explorer</a>
            <a class="nav-link" href="#device-settings"><span class="nav-symbol">⚙</span> Device settings</a>
        </nav>

        <div class="sidebar-bottom">
            <div class="connection-indicator"><span class="status-dot @(_priceError is not null ? "status-error" : "")"></span> @(_priceError is not null ? "Price feed unavailable" : _loading ? "Connecting to MyHome API" : "Tibber prices via MyHome API")</div>
            <div class="sidebar-note">Smart energy, clearer decisions.</div>
        </div>
    </aside>

    <main class="main-content" id="overview">
        <header class="topbar">
            <div class="breadcrumb">HOME <span>/</span> ENERGY OVERVIEW</div>
            <div class="topbar-right">
                <span class="today-label">@DateTime.Now.ToString("dddd, d MMMM yyyy", CultureInfo.InvariantCulture)</span>
                <span class="avatar" aria-hidden="true">M</span>
            </div>
        </header>

        <div class="page-content">
            <div class="page-heading">
                <div>
                    <div class="eyebrow"><span class="eyebrow-line"></span> YOUR HOME AT A GLANCE</div>
                    <h1>Energy overview<span class="heading-dot">.</span></h1>
                    <p>Know what your energy costs, and when it pays to use it.</p>
                </div>
                <button class="refresh-button" type="button" @onclick="RefreshAllAsync" disabled="@_loading">
                    <span aria-hidden="true">↻</span> @(_loading ? "Loading..." : "Refresh data")
                </button>
            </div>

            @if (_priceError is not null)
            {
                <div class="alert" role="alert">
                    <strong>Some data could not be loaded.</strong>
                    <span>@_priceError</span>
                </div>
            }

            @if (_loading && _prices.Count == 0)
            {
                <div class="loading-state" role="status">Loading live energy data...</div>
            }

            <section class="panel price-panel" id="prices" aria-labelledby="prices-title">
                <div class="panel-header">
                    <div>
                        <div class="section-kicker">THE BIG PICTURE</div>
                        <h2 id="prices-title">Electricity prices</h2>
                        <p>Quarter-hour spot prices from Tibber, colored by MyHome's internal price level.</p>
                    </div>
                    <div class="segmented-control" aria-label="Select price day">
                        <button type="button" class="@(!_showTomorrow ? "selected" : "")" aria-pressed="@(!_showTomorrow)" @onclick="() => SelectDayAsync(false)">Today</button>
                        <button type="button" class="@(_showTomorrow ? "selected" : "")" aria-pressed="@_showTomorrow" @onclick="() => SelectDayAsync(true)">Tomorrow</button>
                    </div>
                </div>

                @if (VisiblePrices.Count > 0)
                {
                    <div class="chart-summary">
                        <span>@SelectedDay.ToString("dddd, d MMMM", CultureInfo.InvariantCulture)</span>
                        <span>Average <strong>@Price(VisiblePrices.Average(e => e.PriceDetails.PriceTotal)) SEK/kWh</strong></span>
                        <span>Low <strong>@Price(VisiblePrices.Min(e => e.PriceDetails.PriceTotal))</strong></span>
                        <span>High <strong>@Price(VisiblePrices.Max(e => e.PriceDetails.PriceTotal))</strong></span>
                    </div>
                    <div class="chart-frame">
                        <div class="chart-y-label">SEK / kWh</div>
                        <div class="chart-plot" role="img" aria-label="Quarter-hour electricity prices for @SelectedDay.ToString("d MMMM", CultureInfo.InvariantCulture), from @Price(VisiblePrices.Min(e => e.PriceDetails.PriceTotal)) to @Price(VisiblePrices.Max(e => e.PriceDetails.PriceTotal)) SEK per kWh; colors represent MyHome internal price levels">
                            <div class="chart-gridline top"><span>@Price(ChartMax)</span></div>
                            <div class="chart-gridline middle"><span>@Price((ChartMax + ChartMin) / 2)</span></div>
                            <div class="chart-gridline zero" style="bottom:@ChartZeroPosition()"><span>@Price(0)</span></div>
                            @foreach (var entry in VisiblePrices)
                            {
                                <div class="chart-slot">
                                    <div class="price-bar @LevelClass(entry.PriceDetails.LevelInternal) @(entry.PriceDetails.PriceTotal < 0 ? "negative" : "") @(entry.PriceDetails.StartsAt < DateTimeOffset.Now ? "past" : "")"
                                         style="@BarStyle(entry)"
                                         title="@PriceTooltip(entry)"></div>
                                </div>
                            }
                        </div>
                        <div class="chart-axis">
                            @for (var i = 0; i < VisiblePrices.Count; i++)
                            {
                                <div class="axis-slot">
                                    @if (VisiblePrices[i].PriceDetails.StartsAt.Minute == 0 && VisiblePrices[i].PriceDetails.StartsAt.Hour % 4 == 0)
                                    {
                                        <span>@VisiblePrices[i].PriceDetails.StartsAt.ToString("HH:mm")</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                    <div class="chart-legend">
                        <strong>MYHOME INTERNAL LEVEL</strong>
                        <span><i class="legend-dot very-cheap"></i> Very cheap</span>
                        <span><i class="legend-dot cheap"></i> Cheap</span>
                        <span><i class="legend-dot normal"></i> Normal</span>
                        <span><i class="legend-dot expensive"></i> Expensive</span>
                        <span><i class="legend-dot very-expensive"></i> Very expensive</span>
                        <span><i class="legend-dot unknown"></i> Unknown</span>
                    </div>

                    <div class="consumption-header">
                        <h3>Energy consumption</h3>
                        <p>Measured hourly consumption, so you can see if usage was high when prices were high.</p>
                    </div>
                    @if (_consumptionLoading)
                    {
                        <div class="loading-state" role="status">Loading consumption data...</div>
                    }
                    else if (_consumptionError is not null)
                    {
                        <div class="empty-state">@_consumptionError</div>
                    }
                    else if (VisibleConsumption.Count > 0)
                    {
                        <div class="chart-frame consumption-frame">
                            <div class="chart-y-label">kWh</div>
                            <div class="chart-plot consumption-plot" role="img" aria-label="Hourly electricity consumption for @SelectedDay.ToString("d MMMM", CultureInfo.InvariantCulture)">
                                <div class="chart-gridline top"><span>@Quantity(ConsumptionMax)</span></div>
                                <div class="chart-gridline zero" style="bottom:0"><span>@Quantity(0)</span></div>
                                @foreach (var entry in VisibleConsumption)
                                {
                                    var hasData = MeasuredConsumption.Contains(entry);
                                    <div class="chart-slot">
                                        <div class="consumption-bar @(hasData && entry.StartsAt < DateTimeOffset.Now ? "past" : "future")"
                                             style="@ConsumptionBarStyle(entry)"
                                             title="@(hasData ? ConsumptionTooltip(entry) : $"{entry.StartsAt:HH:mm} — no data yet")"></div>
                                    </div>
                                }
                            </div>
                            <div class="chart-axis">
                                @foreach (var entry in VisibleConsumption)
                                {
                                    <div class="axis-slot">
                                        @if (entry.StartsAt.Hour % 4 == 0)
                                        {
                                            <span>@entry.StartsAt.ToString("HH:mm")</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">No consumption data is available for @(_showTomorrow ? "tomorrow." : "today yet.")</div>
                    }
                }
                else
                {
                    <div class="empty-state">No prices are available for @(_showTomorrow ? "tomorrow yet. Tibber usually publishes tomorrow's prices in the afternoon." : "today.")</div>
                }
            </section>

            <section class="panel settings-panel" id="device-settings" aria-labelledby="device-settings-title">
                <div class="panel-header">
                    <div>
                        <div class="section-kicker">AUTOMATION TUNING</div>
                        <h2 id="device-settings-title">Device settings</h2>
                        <p>Baselines and comfort/operation modes used when MyHome automates your devices.</p>
                    </div>
                </div>

                @if (_deviceSettingsLoading && _deviceSettings is null)
                {
                    <div class="loading-state" role="status">Loading device settings...</div>
                }
                else if (_deviceSettingsError is not null && _deviceSettings is null)
                {
                    <div class="alert" role="alert">
                        <strong>Device settings could not be loaded.</strong>
                        <span>@_deviceSettingsError</span>
                    </div>
                }
                else if (_deviceSettings is not null)
                {
                    @if (_deviceSettingsError is not null)
                    {
                        <div class="alert" role="alert">
                            <strong>Device settings could not be saved.</strong>
                            <span>@_deviceSettingsError</span>
                        </div>
                    }
                    @if (_deviceSettingsSaveMessage is not null)
                    {
                        <div class="alert alert-success" role="status">
                            <span>@_deviceSettingsSaveMessage</span>
                        </div>
                    }

                    <EditForm Model="_deviceSettings" OnValidSubmit="SaveDeviceSettingsAsync">
                        <DataAnnotationsValidator />

                        <div class="settings-group">
                            <h3>Baselines</h3>
                            <div class="form-grid">
                                <label class="form-field">
                                    <span>Nibe heat offset baseline</span>
                                    <InputNumber @bind-Value="_deviceSettings.HeatOffsetBaseline" />
                                </label>
                                <label class="form-field">
                                    <span>Bath floor 0 baseline (°C)</span>
                                    <InputNumber @bind-Value="_deviceSettings.ThermostatBathZeroTemperatureBaseline" />
                                </label>
                                <label class="form-field">
                                    <span>Bath floor 1 baseline (°C)</span>
                                    <InputNumber @bind-Value="_deviceSettings.ThermostatBathOneTemperatureBaseline" />
                                </label>
                                <label class="form-field">
                                    <span>LLVP Gree baseline (°C)</span>
                                    <InputNumber @bind-Value="_deviceSettings.LlvpGreeTemperatureBaseline" />
                                </label>
                                <label class="form-field">
                                    <span>LLVP Hero baseline (°C)</span>
                                    <InputNumber @bind-Value="_deviceSettings.LlvpHeroTemperatureBaseline" />
                                </label>
                                <label class="form-field">
                                    <span>Dehumidifier target humidity baseline (%)</span>
                                    <InputNumber @bind-Value="_deviceSettings.DehumidifierTargetHumidityBaseline" />
                                </label>
                            </div>
                        </div>

                        <div class="settings-group">
                            <h3>Comfort modes</h3>
                            <div class="form-grid">
                                <label class="form-field">
                                    <span>Max savings</span>
                                    <InputSelect @bind-Value="_deviceSettings.ComfortModes.MaxSavings">
                                        @foreach (var mode in ComfortModeValues)
                                        {
                                            <option value="@mode">@mode</option>
                                        }
                                    </InputSelect>
                                </label>
                                <label class="form-field">
                                    <span>Economic</span>
                                    <InputSelect @bind-Value="_deviceSettings.ComfortModes.Economic">
                                        @foreach (var mode in ComfortModeValues)
                                        {
                                            <option value="@mode">@mode</option>
                                        }
                                    </InputSelect>
                                </label>
                                <label class="form-field">
                                    <span>Baseline</span>
                                    <InputSelect @bind-Value="_deviceSettings.ComfortModes.Baseline">
                                        @foreach (var mode in ComfortModeValues)
                                        {
                                            <option value="@mode">@mode</option>
                                        }
                                    </InputSelect>
                                </label>
                                <label class="form-field">
                                    <span>Moderate</span>
                                    <InputSelect @bind-Value="_deviceSettings.ComfortModes.Moderate">
                                        @foreach (var mode in ComfortModeValues)
                                        {
                                            <option value="@mode">@mode</option>
                                        }
                                    </InputSelect>
                                </label>
                                <label class="form-field">
                                    <span>Enhanced</span>
                                    <InputSelect @bind-Value="_deviceSettings.ComfortModes.Enhanced">
                                        @foreach (var mode in ComfortModeValues)
                                        {
                                            <option value="@mode">@mode</option>
                                        }
                                    </InputSelect>
                                </label>
                            </div>
                        </div>

                        <div class="settings-group">
                            <h3>Operation modes</h3>
                            <div class="form-grid">
                                <label class="form-field">
                                    <span>Max savings</span>
                                    <InputSelect @bind-Value="_deviceSettings.OpModes.MaxSavings">
                                        @foreach (var mode in OpModeValues)
                                        {
                                            <option value="@mode">@mode</option>
                                        }
                                    </InputSelect>
                                </label>
                                <label class="form-field">
                                    <span>Economic</span>
                                    <InputSelect @bind-Value="_deviceSettings.OpModes.Economic">
                                        @foreach (var mode in OpModeValues)
                                        {
                                            <option value="@mode">@mode</option>
                                        }
                                    </InputSelect>
                                </label>
                                <label class="form-field">
                                    <span>Baseline</span>
                                    <InputSelect @bind-Value="_deviceSettings.OpModes.Baseline">
                                        @foreach (var mode in OpModeValues)
                                        {
                                            <option value="@mode">@mode</option>
                                        }
                                    </InputSelect>
                                </label>
                                <label class="form-field">
                                    <span>Moderate</span>
                                    <InputSelect @bind-Value="_deviceSettings.OpModes.Moderate">
                                        @foreach (var mode in OpModeValues)
                                        {
                                            <option value="@mode">@mode</option>
                                        }
                                    </InputSelect>
                                </label>
                                <label class="form-field">
                                    <span>Enhanced</span>
                                    <InputSelect @bind-Value="_deviceSettings.OpModes.Enhanced">
                                        @foreach (var mode in OpModeValues)
                                        {
                                            <option value="@mode">@mode</option>
                                        }
                                    </InputSelect>
                                </label>
                                <label class="form-field">
                                    <span>Max price auto mode (SEK/kWh)</span>
                                    <InputNumber @bind-Value="_deviceSettings.OpModes.MaxPriceAutoMode" step="0.01" />
                                </label>
                                <label class="form-field form-field-readonly">
                                    <span>Max price auto mode, night time (SEK/kWh)</span>
                                    <input type="text" value="@Price(_deviceSettings.OpModes.MaxPriceAutoModeNightTime)" disabled />
                                </label>
                            </div>
                        </div>

                        <div class="form-actions">
                            <button class="action-button" type="submit" disabled="@_deviceSettingsSaving">
                                @(_deviceSettingsSaving ? "Saving..." : "Save device settings")
                            </button>
                        </div>
                    </EditForm>
                }
            </section>

            <footer class="footer">
                <span>MYHOME <span class="footer-divider">/</span> ENERGY DASHBOARD</span>
                <span>@(_lastUpdated is null ? "Waiting for data" : $"Updated {_lastUpdated:HH:mm:ss}") · Prices provided by Tibber</span>
            </footer>
        </div>
    </main>
</div>

@code {
    private static readonly CultureInfo NumberCulture = CultureInfo.GetCultureInfo("sv-SE");
    private IReadOnlyList<EnergyConsumptionEntry> _prices = [];
    private IReadOnlyList<EnergyConsumptionHour> _consumption = [];
    private DateOnly _today = DateOnly.FromDateTime(DateTime.Now);
    private DateTime? _lastUpdated;
    private string? _priceError;
    private string? _consumptionError;
    private bool _loading = true;
    private bool _consumptionLoading = true;
    private bool _showTomorrow;

    private DateOnly SelectedDay => _today.AddDays(_showTomorrow ? 1 : 0);
    private IReadOnlyList<EnergyConsumptionEntry> VisiblePrices => _prices
        .Where(e => DateOnly.FromDateTime(e.PriceDetails.StartsAt.DateTime) == SelectedDay)
        .OrderBy(e => e.PriceDetails.StartsAt)
        .ToList();
    private decimal ChartMin => Math.Min(0, VisiblePrices.Min(e => e.PriceDetails.PriceTotal));
    private decimal ChartMax => Math.Max(0, VisiblePrices.Max(e => e.PriceDetails.PriceTotal));
    private decimal ChartRange => ChartMax == ChartMin ? 1 : ChartMax - ChartMin;

    // Pads the measured hours out to a full 24-hour grid so the consumption chart's x-axis
    // lines up with the quarter-hour price chart above it, instead of stretching to fit
    // whatever subset of hours has been measured so far.
    private IReadOnlyList<EnergyConsumptionHour> VisibleConsumption
    {
        get
        {
            var byHour = _consumption.ToDictionary(e => e.StartsAt.Hour);
            var dayStart = new DateTimeOffset(SelectedDay.ToDateTime(TimeOnly.MinValue), DateTimeOffset.Now.Offset);
            return Enumerable.Range(0, 24)
                .Select(hour => byHour.TryGetValue(hour, out var entry)
                    ? entry
                    : new EnergyConsumptionHour { StartsAt = dayStart.AddHours(hour), ConsumptionKWh = 0 })
                .OrderBy(e => e.StartsAt)
                .ToList();
        }
    }
    private HashSet<EnergyConsumptionHour> MeasuredConsumption => _consumption.ToHashSet();
    private decimal ConsumptionMax => Math.Max(0.1m, VisibleConsumption.Count > 0 ? VisibleConsumption.Max(e => e.ConsumptionKWh) : 0);

    private static readonly IReadOnlyList<ComfortMode> ComfortModeValues = Enum.GetValues<ComfortMode>();
    private static readonly IReadOnlyList<OpMode> OpModeValues = Enum.GetValues<OpMode>();

    private DeviceSettingsProfile? _deviceSettings;
    private string? _deviceSettingsError;
    private string? _deviceSettingsSaveMessage;
    private bool _deviceSettingsLoading = true;
    private bool _deviceSettingsSaving;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(RefreshAsync(), LoadConsumptionAsync(), LoadDeviceSettingsAsync());
    }

    private async Task SelectDayAsync(bool showTomorrow)
    {
        if (_showTomorrow == showTomorrow)
        {
            return;
        }

        _showTomorrow = showTomorrow;
        await LoadConsumptionAsync();
    }

    private async Task RefreshAllAsync() =>
        await Task.WhenAll(RefreshAsync(), LoadConsumptionAsync());

    private async Task LoadDeviceSettingsAsync()
    {
        _deviceSettingsLoading = true;
        _deviceSettingsError = null;

        try
        {
            _deviceSettings = await DeviceSettings.GetAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or TaskCanceledException or InvalidOperationException)
        {
            Logger.LogError(ex, "Could not load device settings");
            _deviceSettingsError = "Device settings are unavailable.";
        }

        _deviceSettingsLoading = false;
    }

    private async Task SaveDeviceSettingsAsync()
    {
        if (_deviceSettings is null)
        {
            return;
        }

        _deviceSettingsSaving = true;
        _deviceSettingsError = null;
        _deviceSettingsSaveMessage = null;

        try
        {
            await DeviceSettings.SaveAsync(_deviceSettings);
            _deviceSettingsSaveMessage = "Device settings saved.";
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or TaskCanceledException or InvalidOperationException)
        {
            Logger.LogError(ex, "Could not save device settings");
            _deviceSettingsError = "Device settings could not be saved. Please try again.";
        }

        _deviceSettingsSaving = false;
    }

    private async Task RefreshAsync()
    {
        _loading = true;
        _priceError = null;
        _today = DateOnly.FromDateTime(DateTime.Now);

        try
        {
            _prices = await Dashboard.GetPricesAsync();
            _lastUpdated = DateTime.Now;
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or TaskCanceledException or InvalidOperationException)
        {
            Logger.LogError(ex, "Could not load Tibber energy prices");
            _priceError = _prices.Count > 0 ? "Prices could not be refreshed; previously loaded prices are shown." : "Prices are unavailable.";
        }

        _loading = false;
    }

    private async Task LoadConsumptionAsync()
    {
        _consumptionLoading = true;
        _consumptionError = null;

        try
        {
            _consumption = await Dashboard.GetConsumptionAsync(SelectedDay);
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or TaskCanceledException or InvalidOperationException)
        {
            Logger.LogError(ex, "Could not load hourly energy consumption");
            _consumption = [];
            _consumptionError = "Consumption data is unavailable.";
        }

        _consumptionLoading = false;
    }

    private static string Price(decimal value) => value.ToString("0.00", NumberCulture);
    private static string Quantity(decimal value) => value.ToString("0.#", NumberCulture);

    private static string LevelName(EnergyPriceLevel level) => level switch
    {
        EnergyPriceLevel.VeryCheap => "Very cheap",
        EnergyPriceLevel.Cheap => "Cheap",
        EnergyPriceLevel.Normal => "Normal",
        EnergyPriceLevel.Expensive => "Expensive",
        EnergyPriceLevel.VeryExpensive => "Very expensive",
        _ => "Unknown"
    };

    private static string LevelClass(EnergyPriceLevel level) => level switch
    {
        EnergyPriceLevel.VeryCheap => "very-cheap",
        EnergyPriceLevel.Cheap => "cheap",
        EnergyPriceLevel.Normal => "normal",
        EnergyPriceLevel.Expensive => "expensive",
        EnergyPriceLevel.VeryExpensive => "very-expensive",
        _ => "unknown"
    };

    private string ChartZeroPosition() =>
        FormattableString.Invariant($"{(double)(-ChartMin / ChartRange) * 100:0.##}%");

    private string BarStyle(EnergyConsumptionEntry entry)
    {
        var price = entry.PriceDetails.PriceTotal;
        var bottom = (price < 0 ? price - ChartMin : -ChartMin) / ChartRange * 100;
        var height = Math.Abs(price) / ChartRange * 100;
        return FormattableString.Invariant($"bottom:{bottom:0.##}%;height:{height:0.##}%");
    }

    private string PriceTooltip(EnergyConsumptionEntry entry)
    {
        var details = entry.PriceDetails;
        return $"{details.StartsAt:HH:mm} — {Price(details.PriceTotal)} SEK/kWh · MyHome: {LevelName(details.LevelInternal)} · Tibber: {LevelName(details.LevelExternal)}";
    }

    private string ConsumptionBarStyle(EnergyConsumptionHour entry)
    {
        var height = Math.Max(0, entry.ConsumptionKWh) / ConsumptionMax * 100;
        return FormattableString.Invariant($"bottom:0%;height:{height:0.##}%");
    }

    private string ConsumptionTooltip(EnergyConsumptionHour entry) =>
        $"{entry.StartsAt:HH:mm} — {Quantity(entry.ConsumptionKWh)} kWh";
}
